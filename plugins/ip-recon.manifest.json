{
  "identifier": "run.vineyard.pluginpacks.ip_recon",
  "content_type": "vineyard:pluginpack",
  "name": "IP Recon",
  "version": "1.2.0",
  "description": "Enriches IP Address nodes with RDAP allocation, Shodan InternetDB open ports/CVEs/hostnames/tags, geolocation, and a Tor exit-node check.",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "network",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.rdap_ip",
      "content_type": "vineyard:plugin",
      "name": "RDAP IP",
      "version": "1.0.2",
      "description": "Looks up each selected IP Address in RDAP. Creates a Netblock node (CIDR, network name, country) linked \"within netblock\" and fills the IP's organization and country_code if empty.",
      "icon": "boxes",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "netblock"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "node:update",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://rdap.org/",
            "methods": [
              "GET"
            ],
            "purpose": "Look up each selected IP's netblock and owner in RDAP."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.shodan_internetdb",
      "content_type": "vineyard:plugin",
      "name": "Shodan InternetDB",
      "version": "1.1.0",
      "description": "Looks up each selected IP Address in Shodan InternetDB. Creates a Host node with the open ports (and OS when known) linked \"exposes\", Vulnerability nodes for known CVEs linked \"affected by\", and Domain nodes for reverse hostnames linked \"resolves to\", and writes Shodan's tags for the IP (e.g. cdn, cloud, honeypot, self-signed) onto it as shodan_tags.",
      "icon": "radar",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "host"
          },
          {
            "typepack": "run.vineyard.typepacks.threat",
            "category": "threat",
            "name": "vulnerability"
          },
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "domain"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "node:update",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://internetdb.shodan.io/",
            "methods": [
              "GET"
            ],
            "purpose": "Look up open ports, known CVEs, hostnames and tags for each selected IP in Shodan InternetDB."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.ip_geolocation",
      "content_type": "vineyard:plugin",
      "name": "IP Geolocation",
      "version": "1.0.2",
      "description": "Geolocates each selected IP Address via ipwho.is. Creates a Location node (city, region, country, latitude/longitude) linked \"geolocated to\" and fills the IP's country_code and organization if empty.",
      "icon": "map-pin",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.geo",
            "category": "geo",
            "name": "location"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "node:update",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://ipwho.is/",
            "methods": [
              "GET"
            ],
            "purpose": "Look up each selected IP's approximate location and ISP."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.tor_exit_check",
      "content_type": "vineyard:plugin",
      "name": "Tor Exit Node",
      "version": "1.0.2",
      "description": "Checks each selected IP Address against the Tor Project's list of exit relays and sets is_tor_exit (true/false) and tor_exit_checked_at (the list's publication time) on the IP. Creates no nodes.",
      "icon": "shield",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "ip_address"
          }
        ],
        "produces": []
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:update"
        ],
        "network": [
          {
            "endpoint": "https://onionoo.torproject.org/details",
            "methods": [
              "GET"
            ],
            "purpose": "Fetch the Tor Project's list of exit relay addresses."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
